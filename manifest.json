{
  "manifest_version": 3,
  "name": "Envato Author Earnings Calculator",
  "version": "1.0.0",
  "description": "Calculates earnings for authors on CodeCanyon and ThemeForest based on portfolio items, average prices, and completed sales.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://codecanyon.net/*",
    "https://themeforest.net/*",
    "https://open.er-api.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://codecanyon.net/user/*",
        "https://themeforest.net/user/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
